<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MaterialsMnagement.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="MaterialsMnagement.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="MaterialsMnagement">

	<Grid RowDefinitions="40,*,10" Background="Plum">
		<TextBlock Grid.Row="0" Text=" Система управления материалами" Foreground="Purple" FontSize="18" FontWeight="DemiBold"/>
		<ContentControl Grid.Row="1" Content="{Binding CurrentView}"/>
	</Grid>

</Window>
