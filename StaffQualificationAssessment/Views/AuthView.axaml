<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="StaffQualificationAssessment.Views.AuthView"
			 xmlns:vm="using:StaffQualificationAssessment.ViewModels"
             x:DataType="vm:AuthViewModel">
	<StackPanel>
		<TextBlock Text="Авторизация" HorizontalAlignment="Center"/>
		<TextBlock Text="Код сотрудника"/>
		<MaskedTextBox Text="{Binding UserCode}" Mask="9999"/>
		<Button Content="Войти" Command="{Binding LogIn}"/>
		<Button Content="Регистрация" Command="{Binding GoToRegistrationView}" HorizontalAlignment="Right"/>
	</StackPanel>
</UserControl>
